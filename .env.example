# `npm run dev:local` needs no .env file. The values below are for a real
# PostgreSQL/Supabase/Neon environment.
# Runtime connection. Use the provider's pooled URL in production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nepal_school_erp?schema=public"

# Prisma CLI connection. Use a direct, non-pooler URL for migrations.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/nepal_school_erp?schema=public"

APP_URL="http://localhost:3000"
AUTH_SECRET="replace-with-at-least-32-random-characters"
# Set one stable 32-byte base64 key across all production instances.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="<base64-encoded-32-random-bytes>"
# Omit for single-instance local development; never use an invalid placeholder.
SESSION_TTL_HOURS="12"

# Development bootstrap only. The seed refuses production credentials unless
# ALLOW_PRODUCTION_SEED is deliberately set to true.
SUPER_ADMIN_EMAIL="admin@example.test"
SUPER_ADMIN_USERNAME="superadmin"
SUPER_ADMIN_INITIAL_PASSWORD="ChangeMe@12345"
ALLOW_PRODUCTION_SEED="false"

# Future Cloudflare R2/S3-compatible storage integration.
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET=""
