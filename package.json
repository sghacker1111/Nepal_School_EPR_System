{
  "name": "nepal-school-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Production-oriented multi-school Nepal School ERP",
  "scripts": {
    "dev": "next dev",
    "dev:local": "pglite-server --db=.local-pglite --port=55432 --max-connections=10 --run \"node node_modules/tsx/dist/cli.mjs scripts/local-start.ts\" --include-database-url",
    "dev:local:clean": "pglite-server --db=memory:// --port=55432 --max-connections=10 --run \"node node_modules/tsx/dist/cli.mjs scripts/local-start.ts\" --include-database-url",
    "dev:local:app": "tsx scripts/local-start.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "tsx scripts/integration-runner.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@react-pdf/renderer": "^4.6.1",
    "@tanstack/react-table": "^9.1.2",
    "argon2": "^0.45.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.33.0",
    "next": "^16.3.1",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@electric-sql/pglite-socket": "^0.2.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "prisma@7.9.1": true,
    "unrs-resolver@1.12.2": true,
    "@prisma/engines@7.9.1": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "deepmerge-ts": "8.0.1",
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
